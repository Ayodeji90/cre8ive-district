# Database
DATABASE_URL=postgresql+asyncpg://cre8ive:localdev@localhost:5432/cre8ive

# Redis
REDIS_URL=redis://localhost:6379

# Auth (must match the NextAuth secret on the frontend)
JWT_SECRET=replace-with-the-nextauth-secret
JWT_ALGORITHM=HS256
# Shared secret for NextAuth's adapter calls (defaults to JWT_SECRET when empty)
AUTH_ADAPTER_SECRET=

# Branding Agent (AI provider keys are configured in services/branding-agent)
BRANDING_AGENT_URL=http://localhost:8001
BRANDING_AGENT_API_KEY=local-development-key

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=cre8ive-assets
R2_PUBLIC_URL=

# Paystack (test keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Cre8ive District <brands@cre8ivedistrict.com>

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# WhatsApp (future)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# App
MARKETING_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENV=development
