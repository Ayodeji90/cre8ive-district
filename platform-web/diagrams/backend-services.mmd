        S_PAY["paystack.py 77L\nAPI Client\nVerify Transaction"]
        S_EMAIL["email.py 64L\nResend Client\nTemplate Render"]
        S_JOBS["jobs.py 45L\narq Definitions\nBackground Tasks"]
    end

    subgraph Infra["Infrastructure"]
        DB["PostgreSQL 16\n8 Tables"]
        REDIS["Redis 7\nSession + Queue"]
        WORKER["arq Worker\nBackground Jobs"]
        EBUS["EventBus\nSSE to Admin"]
    end

    R_CHAT --> S_CHAT
    R_BRANDS --> S_BRAND
    R_BILL --> S_BILL
    R_HOOK --> S_PAY
    R_REV --> S_REV
    R_ASSET --> S_ASSET
    R_DLVR --> S_DLVR

    S_CHAT -->|"stream AI"| S_BRAND
    S_BRAND -->|"create review"| S_REV
    S_REV -->|"on approve"| S_JOBS
