[TEMPLATE]
# Backend API shared by the platform and admin applications.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001
# Server-side URL NextAuth's adapter uses to reach the API (defaults to NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=http://localhost:8000

# Platform authentication (configure with the auth/backend team).
# NextAuth's own encryption secret.
AUTH_SECRET=
# Public origin of the platform app; used to build OAuth and magic-link callbacks.
AUTH_URL=http://localhost:3001
# Must match the backend's JWT_SECRET: tokens are signed here and verified by FastAPI.
JWT_SECRET=
# Shared secret for NextAuth's adapter calls (defaults to JWT_SECRET on both sides).
AUTH_ADAPTER_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
# Verified Resend sender for magic-link emails.
AUTH_EMAIL_FROM="Cre8ive District <login@cre8ivedistrict.com>"

# Billing (public key only; secret keys stay on the backend).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Marketing waitlist submissions are stored and confirmed by the backend API.
# The marketing server reaches it through API_INTERNAL_URL (above).
