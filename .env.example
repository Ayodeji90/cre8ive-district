# Cre8ive District local configuration
#
# Copy this file to the repository root as `.env`. It is the only local
# environment file used by the website, platform apps, API, and AI services.
# Never commit the real `.env` file.

# Public application URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:8000
MARKETING_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENV=development

# Platform authentication
# AUTH_SECRET and JWT_SECRET must be the same long, random value in production.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3001
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
AUTH_ADAPTER_SECRET=replace-with-a-separate-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Cre8ive District <login@cre8ivedistrict.com>"

# Local infrastructure
DATABASE_URL=postgresql+asyncpg://cre8ive:localdev@localhost:5432/cre8ive
REDIS_URL=redis://localhost:6379

# Service-to-service authentication
BRANDING_AGENT_URL=http://localhost:8001
BRANDING_AGENT_API_KEY=local-development-key
WEBSITE_AGENT_URL=http://localhost:8002
WEBSITE_AGENT_API_KEY=local-development-key
RUN_ENGINE_URL=http://localhost:8003
RUN_ENGINE_API_KEY=local-development-key
PLATFORM_API_URL=http://localhost:8000
PLATFORM_API_KEY=local-development-key
SERVICE_API_KEY=local-development-key
USE_IN_MEMORY_REPO=false
USE_IN_MEMORY_EVENTS=false

# AI providers
AI_STUB=true
LLM_PROVIDER=
LLM_ROUTING_ORDER=openrouter
LLM_PROVIDER_TIMEOUT_SECONDS=20
GROQ_API_KEY=
GROQ_MODEL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_API_BASE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
WEBSITE_MODEL=anthropic/claude-sonnet-4
DEPLOY_STUB=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
IDEOGRAM_API_KEY=
IMAGE_PROVIDER=ideogram

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=cre8ive-assets
R2_PUBLIC_URL=

# Payments and email
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
RESEND_API_KEY=
EMAIL_FROM="Cre8ive District <brands@cre8ivedistrict.com>"

# Deployment and future integrations
VERCEL_TOKEN=
VERCEL_TEAM_ID=
PRIMARY_DOMAIN_SUFFIX=cre8ivedistrict.app
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
